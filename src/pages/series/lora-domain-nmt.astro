---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'LoRA for Low-Resource Domain NMT',
  description:
    'A research-oriented series on LoRA for low-resource domain neural machine translation, connecting data quality, domain adaptation, hyperparameter optimization, terminology, and evaluation.',
};

const sections = [
  {
    part: 'Part I',
    title: 'Research problem',
    notes: [
      ['Why Low-Resource Domain MT Is Hard', '/why-low-resource-domain-mt-is-hard'],
      ['Why LoRA Fits Low-Resource Domain Adaptation', '/why-lora-fits-low-resource-domain-adaptation'],
    ],
  },
  {
    part: 'Part II',
    title: 'Method and adaptation',
    notes: [
      ['LoRA for Neural Machine Translation', '/what-lora-actually-changes'],
      ['Hyperparameter Optimization for LoRA NMT', '/hyperparameter-optimization-grid-optuna-asha'],
      ['LoRA vs Full Fine-Tuning: What Do We Actually Save?', '/lora-vs-full-finetuning-what-do-we-save'],
    ],
  },
  {
    part: 'Part III',
    title: 'Data-centric MT',
    notes: [
      ['Data Quality Diagnostics for Parallel Corpora', '/data-quality-diagnostics-for-parallel-corpora'],
      ['Terminology as an Evaluation Problem in Domain MT', '/terminology-evaluation-in-domain-mt'],
      ['Data Scaling for LoRA Domain Adaptation', '/data-scaling-for-lora-domain-adaptation'],
    ],
  },
  {
    part: 'Part IV',
    title: 'Evaluation and research story',
    notes: [
      ['How to Evaluate Machine Translation Beyond BLEU', '/bleu-chrf-comet-practical-guide'],
      [
        'My LoRA NMT Project: Research Question, Method, Findings, and Limitations',
        '/my-lora-nmt-project-research-question-method-findings',
      ],
    ],
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="Research series"
    actions={[
      {
        variant: 'primary',
        text: 'Start the series',
        href: '/why-low-resource-domain-mt-is-hard',
        icon: 'tabler:language',
      },
      { text: '中文', href: '/zh/series/lora-domain-nmt' },
      { text: 'Multilingual AI', href: '/category/multilingual-ai' },
    ]}
  >
    <Fragment slot="title">LoRA for Low-Resource Domain NMT</Fragment>
    <Fragment slot="subtitle">
      A research-facing path through low-resource domain MT, LoRA adaptation, data quality, HPO, terminology evaluation,
      data scaling, and the project story behind English--Norwegian petroleum translation.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        sections.map((section) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-violet-600 dark:text-violet-300">
              {section.part}
            </p>
            <h2 class="mb-4 text-2xl font-bold">{section.title}</h2>
            <ol class="space-y-3 text-muted dark:text-slate-300">
              {section.notes.map(([title, href], index) => (
                <li>
                  <a class="hover:text-primary" href={href}>
                    {index + 1}. {title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <Features
    title="Why this belongs in Research, not Foundations"
    subtitle="The mathematical ideas are present, but they serve the research claim: why this method, this data, and this evaluation protocol make sense."
    columns={3}
    items={[
      {
        title: 'Problem-driven',
        description:
          'The series starts from low-resource domain MT and technical risk, not from abstract linear algebra.',
        icon: 'tabler:target-arrow',
      },
      {
        title: 'Method-aware',
        description:
          'LoRA is explained through adaptation capacity, controlled updates, HPO, and full fine-tuning trade-offs.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'Evaluation-focused',
        description: 'BLEU, chrF, COMET, terminology metrics, and human error analysis are treated as evidence design.',
        icon: 'tabler:chart-dots-3',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Read the project story',
        href: '/my-lora-nmt-project-research-question-method-findings',
        icon: 'tabler:arrow-right',
      },
      { text: '中文版本', href: '/zh/series/lora-domain-nmt' },
    ]}
  >
    <Fragment slot="title">The series ends with a thesis-style research narrative.</Fragment>
    <Fragment slot="subtitle">
      It is designed to help explain the project clearly in interviews and future PhD conversations.
    </Fragment>
  </CallToAction>
</Layout>
