---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Statistics for AI Research',
  description:
    'A bilingual series on statistical foundations, uncertainty, model evaluation, and the path from statistics to machine learning.',
};

const sections = [
  {
    part: 'Part I',
    title: 'Statistical Foundations',
    notes: [
      ['Why Statistics Matters for AI Research', '/why-statistics-matters-for-ai-research'],
      ['Random Variables, Expectation, and Variance', '/random-variables-expectation-and-variance'],
      ['Probability Distributions for Machine Learning', '/probability-distributions-for-machine-learning'],
    ],
  },
  {
    part: 'Part II',
    title: 'Uncertainty & Model Evaluation',
    notes: [
      ['Confidence Intervals: Why One Score Is Not Enough', '/confidence-intervals-one-score-is-not-enough'],
      ['Bootstrap Resampling for Model Evaluation', '/bootstrap-resampling-for-model-evaluation'],
      ['Hypothesis Testing Without Rituals', '/hypothesis-testing-without-rituals'],
      ['Effect Size: Statistical Significance Is Not Enough', '/effect-size-statistical-significance-is-not-enough'],
    ],
  },
  {
    part: 'Part III',
    title: 'Statistics → Machine Learning',
    notes: [
      ['Linear Regression as a Statistical Model', '/linear-regression-as-a-statistical-model'],
      ['Regularization: Statistics Behind L1 and L2', '/regularization-statistics-behind-l1-and-l2'],
      ['Bias–Variance Trade-off', '/bias-variance-tradeoff'],
      ['PCA: From Variance to Representation', '/pca-from-variance-to-representation'],
      ['Maximum Likelihood Estimation: Why Models Learn Parameters', '/maximum-likelihood-estimation-why-models-learn-parameters'],
      ['MAP Estimation and Bayesian Thinking', '/map-estimation-and-bayesian-thinking'],
    ],
  },
  {
    part: 'Part IV',
    title: 'Statistical Thinking for AI/NLP',
    notes: [
      ['Multiple Comparisons in AI Experiments', '/multiple-comparisons-in-ai-experiments'],
      ['Power Analysis: How Many Experiments Do You Need?', '/power-analysis-how-many-experiments'],
      ['ANOVA for Comparing Multiple Models', '/anova-for-comparing-multiple-models'],
      ['Statistical Testing for NLP and LLM Evaluation', '/statistical-testing-for-nlp-and-llm-evaluation'],
      ['Correlation vs. Causation in AI Research', '/correlation-vs-causation-in-ai-research'],
    ],
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="Series"
    actions={[
      {
        variant: 'primary',
        text: 'Start with the first note',
        href: '/why-statistics-matters-for-ai-research',
        icon: 'tabler:chart-dots',
      },
      { text: '中文', href: '/zh/series/statistics-for-ai-research' },
      { text: 'Statistics posts', href: '/category/statistics' },
    ]}
  >
    <Fragment slot="title">Statistics for AI Research</Fragment>
    <Fragment slot="subtitle">
      A practical learning path from probability and statistical inference to ML/NLP evaluation. Each note has a
      separate Chinese version and a language switch.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        sections.map((section) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-600 dark:text-blue-300">
              {section.part}
            </p>
            <h2 class="mb-4 text-2xl font-bold">{section.title}</h2>
            <ol class="space-y-3 text-muted dark:text-slate-300">
              {section.notes.map(([title, href], index) => (
                <li>
                  <a class="hover:text-primary" href={href}>
                    {index + 1}. {title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <Features
    title="How this series is designed"
    subtitle="The series borrows the learning strengths of Seeing Theory, StatQuest, Think Stats, ISLR/ISLP, and statistical inference texts, then translates them into AI/NLP research habits."
    columns={3}
    items={[
      {
        title: 'Concept first',
        description: 'Each note starts with a visual mental model before formulas or experimental details.',
        icon: 'tabler:bulb',
      },
      {
        title: 'AI/NLP examples',
        description: 'Examples connect the concept to MT, RAG, LLM evaluation, bias analysis, and applied ML systems.',
        icon: 'tabler:microscope',
      },
      {
        title: 'Research writing',
        description: 'The notes emphasize how to make careful claims, not just how to compute a number.',
        icon: 'tabler:writing',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Read the first note',
        href: '/why-statistics-matters-for-ai-research',
        icon: 'tabler:arrow-right',
      },
      { text: '中文版本', href: '/zh/series/statistics-for-ai-research' },
    ]}
  >
    <Fragment slot="title">Start with uncertainty.</Fragment>
    <Fragment slot="subtitle">
      My working definition: statistics is the language I use when an AI experiment produces a number and I need to decide
      how much to trust it.
    </Fragment>
  </CallToAction>
</Layout>
