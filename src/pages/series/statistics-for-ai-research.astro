---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Statistics for AI Research',
  description:
    'A bilingual series on statistical foundations, uncertainty, model evaluation, and the path from statistics to machine learning.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Series"
    actions={[
      {
        variant: 'primary',
        text: 'Start with the first note',
        href: '/why-statistics-matters-for-ai-research',
        icon: 'tabler:chart-dots',
      },
      { text: 'Statistics posts', href: '/category/statistics' },
    ]}
  >
    <Fragment slot="title">Statistics for AI Research</Fragment>
    <Fragment slot="subtitle">
      AI 研究中的统计直觉 — a bilingual series that turns probability, statistics, and model evaluation into practical
      tools for reasoning about AI experiments.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-600 dark:text-blue-300">Part I</p>
        <h2 class="mb-4 text-2xl font-bold">Statistical Foundations</h2>
        <ol class="space-y-3 text-muted dark:text-slate-300">
          <li>1. Why Statistics Matters for AI Research</li>
          <li>2. Random Variables, Expectation, and Variance</li>
          <li>3. Probability Distributions for Machine Learning</li>
        </ol>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-600 dark:text-blue-300">Part II</p>
        <h2 class="mb-4 text-2xl font-bold">Uncertainty & Evaluation</h2>
        <ol class="space-y-3 text-muted dark:text-slate-300">
          <li>4. Confidence Intervals: Why One Score Is Not Enough</li>
          <li>5. Bootstrap Resampling for Model Evaluation</li>
          <li>6. Hypothesis Testing Without Rituals</li>
        </ol>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-600 dark:text-blue-300">Part III</p>
        <h2 class="mb-4 text-2xl font-bold">Statistics → ML</h2>
        <ol class="space-y-3 text-muted dark:text-slate-300">
          <li>7. Linear Regression as a Statistical Model</li>
          <li>8. PCA: From Variance to Representation</li>
        </ol>
      </div>
    </div>
  </section>

  <Features
    title="Why this series belongs on the blog"
    subtitle="The goal is not to rewrite existing materials. Seeing Theory, 看见统计, and StatQuest are excellent sources for intuition; this series adds my AI/NLP research context."
    columns={3}
    items={[
      {
        title: 'From intuition to experiment',
        description:
          'Concepts like variance, sampling, and confidence intervals become tools for judging whether an AI result is stable.',
        icon: 'tabler:bulb',
      },
      {
        title: 'From formulas to decisions',
        description:
          'Statistics helps decide whether a model comparison is meaningful, whether a metric is enough, and whether data is representative.',
        icon: 'tabler:scale',
      },
      {
        title: 'From foundations to research',
        description:
          'The series connects basic statistics to MT evaluation, RAG evaluation, bias analysis, human annotation, and applied ML systems.',
        icon: 'tabler:microscope',
      },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-blue-50 p-6 dark:bg-slate-900">
      <h2 class="mb-4 text-2xl font-bold">Next-stage topics</h2>
      <div class="grid gap-3 text-sm text-muted dark:text-slate-300 sm:grid-cols-2">
        <span>Correlation vs. Causation in AI Research</span>
        <span>Maximum Likelihood Estimation</span>
        <span>MAP Estimation and Bayesian Thinking</span>
        <span>Regularization: Statistics Behind L1 and L2</span>
        <span>Bias–Variance Trade-off</span>
        <span>ANOVA for Comparing Multiple Models</span>
        <span>Effect Size: Statistical Significance Is Not Enough</span>
        <span>Multiple Comparisons in AI Experiments</span>
        <span>Power Analysis: How Many Experiments Do You Need?</span>
        <span>Statistical Testing for NLP and LLM Evaluation</span>
      </div>
    </div>
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Read the first note',
        href: '/why-statistics-matters-for-ai-research',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Start with uncertainty.</Fragment>
    <Fragment slot="subtitle">
      My working definition: statistics is the language I use when an AI experiment produces a number and I need to
      decide how much to trust it.
    </Fragment>
  </CallToAction>
</Layout>
