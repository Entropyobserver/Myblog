---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'NLP & LLM Foundations',
  description: 'A bilingual series on tokenization, embeddings, seq2seq, attention, Transformers, fine-tuning, PEFT, prompting, and evaluation.',
};

const sections = [
  {
    part: 'Part I',
    title: 'Language as Model Input',
    notes: [
      ['Tokenization and Subwords', '/tokenization-and-subwords'],
      ['Word Embeddings and Sentence Embeddings', '/word-and-sentence-embeddings'],
    ],
  },
  {
    part: 'Part II',
    title: 'Architectures',
    notes: [
      ['Sequence-to-Sequence Models', '/sequence-to-sequence-models'],
      ['Attention Mechanism', '/attention-mechanism'],
      ['Transformers for NLP', '/transformers-for-nlp'],
    ],
  },
  {
    part: 'Part III',
    title: 'Adaptation & Interaction',
    notes: [
      ['Fine-Tuning Transformers', '/fine-tuning-transformers'],
      ['Parameter-Efficient Fine-Tuning', '/parameter-efficient-fine-tuning'],
      ['Prompting and Instruction Following', '/prompting-and-instruction-following'],
    ],
  },
  {
    part: 'Part IV',
    title: 'Evaluation',
    notes: [
      ['NLP Evaluation', '/nlp-evaluation'],
      ['LLM Evaluation and Failure Modes', '/llm-evaluation-and-failure-modes'],
    ],
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="Series"
    actions={[
      {
        variant: 'primary',
        text: 'Start with tokenization',
        href: '/tokenization-and-subwords',
        icon: 'tabler:message-language',
      },
      { text: '中文', href: '/zh/series/nlp-and-llms' },
      { text: 'NLP posts', href: '/category/nlp-and-llms' },
    ]}
  >
    <Fragment slot="title">NLP & LLM Foundations</Fragment>
    <Fragment slot="subtitle">
      A practical research-oriented path through tokenization, embeddings, seq2seq, attention, Transformers,
      fine-tuning, PEFT, prompting, and NLP/LLM evaluation.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        sections.map((section) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-violet-600 dark:text-violet-300">
              {section.part}
            </p>
            <h2 class="mb-4 text-2xl font-bold">{section.title}</h2>
            <ol class="space-y-3 text-muted dark:text-slate-300">
              {section.notes.map(([title, href], index) => (
                <li>
                  <a class="hover:text-primary" href={href}>
                    {index + 1}. {title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <Features
    title="How this series is different"
    subtitle="It is not a generic NLP tutorial. It connects every foundation topic to multilingual AI, domain MT, LoRA/PEFT, RAG, and evaluation."
    columns={3}
    items={[
      {
        title: 'Concept',
        description: 'Jurafsky & Martin, CS224N, and the Illustrated Transformer provide the conceptual backbone.',
        icon: 'tabler:book',
      },
      {
        title: 'Practice',
        description: 'Hugging Face Course, Transformers, Tokenizers, Evaluate, and PEFT provide implementation patterns.',
        icon: 'tabler:code',
      },
      {
        title: 'Research',
        description: 'MT, multilinguality, LoRA, COMET, and LLM failure modes connect the basics to my research profile.',
        icon: 'tabler:microscope',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Read the first note',
        href: '/tokenization-and-subwords',
        icon: 'tabler:arrow-right',
      },
      { text: '中文版本', href: '/zh/series/nlp-and-llms' },
    ]}
  >
    <Fragment slot="title">Start where language becomes model input.</Fragment>
    <Fragment slot="subtitle">
      Tokenization is the quiet first decision that shapes everything a multilingual model can learn.
    </Fragment>
  </CallToAction>
</Layout>
