---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'About',
  description:
    'About Xiaojing Yang and the AI Research Notes blog: bilingual foundations and research notes for applied AI and language technology.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="About this blog"
    actions={[
      { variant: 'primary', text: 'Read the Blog', href: '/blog', icon: 'tabler:book-2' },
      { text: 'Portfolio ↗', href: 'https://nordic-ai.top', target: '_blank' },
    ]}
  >
    <Fragment slot="title">A bilingual notebook for foundations and research.</Fragment>

    <Fragment slot="subtitle">
      I am Xiaojing Yang, an MSc Language Technology student at Uppsala University. This blog is where I organize the
      foundations behind AI work—mathematics, statistics, machine learning, NLP, and research engineering—and connect
      them to applied research in multilingual AI, evaluation, retrieval, and responsible AI.
    </Fragment>
  </Hero>

  <Features
    title="How this site is meant to work"
    subtitle="The blog is not a duplicate of my portfolio. It is the explanation layer: concepts, methods, experiments, and lessons."
    columns={3}
    items={[
      {
        title: 'Foundations first',
        description:
          'Many posts will digest strong existing materials into my own explanations, examples, and bilingual notes.',
        icon: 'tabler:books',
      },
      {
        title: 'Research as application',
        description:
          'Research posts show how those foundations appear in model evaluation, multilingual NLP, RAG, XAI, and applied ML systems.',
        icon: 'tabler:microscope',
      },
      {
        title: 'Bilingual by design',
        description:
          'The interface is English-first for international readers, while posts may be English, Chinese, or bilingual depending on the topic.',
        icon: 'tabler:language',
      },
    ]}
  />

  <Features
    title="Current interests"
    columns={2}
    items={[
      {
        title: 'Building AI systems',
        description:
          'NLP pipelines, Hugging Face training workflows, data processing, experiment tracking, retrieval systems, and usable demos.',
        icon: 'tabler:tool',
      },
      {
        title: 'Evaluating AI systems',
        description:
          'Metrics, statistical testing, human evaluation design, robustness, benchmark construction, and reliability analysis.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Understanding AI systems',
        description:
          'Explainability, bias evaluation, data attribution, Shapley analysis, and controlled model-auditing protocols.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Multilingual language technology',
        description:
          'Machine translation, multilingual NLP, domain adaptation, low-resource settings, terminology, and language variation.',
        icon: 'tabler:message-language',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'View Portfolio ↗',
        href: 'https://nordic-ai.top',
        target: '_blank',
        icon: 'tabler:external-link',
      },
      {
        text: 'GitHub ↗',
        href: 'https://github.com/Entropyobserver',
        target: '_blank',
      },
      {
        text: 'Hugging Face ↗',
        href: 'https://huggingface.co/entropy25',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">Portfolio for outcomes, blog for reasoning.</Fragment>
    <Fragment slot="subtitle">
      If a project page is the finished map, these notes are the field journal: why the route was chosen, where the
      traps were, and what I would do differently next time.
    </Fragment>
  </CallToAction>
</Layout>
