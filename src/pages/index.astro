---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AI Research Notes',
  ignoreTitleTemplate: true,
  description:
    'Bilingual foundations and research notes on mathematics, statistics, machine learning, NLP, LLMs, model evaluation, and applied AI systems.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Foundations + Research"
    actions={[
      { variant: 'primary', text: 'Read the Blog', href: '/blog', icon: 'tabler:book-2' },
      { text: 'View Portfolio ↗', href: 'https://nordic-ai.top', target: '_blank' },
    ]}
  >
    <Fragment slot="title">
      AI Research Notes
      <span class="block text-accent dark:text-white">from foundations to applied systems</span>
    </Fragment>

    <Fragment slot="subtitle">
      A bilingual knowledge base on mathematics, statistics, machine learning, NLP, LLMs, model evaluation, and applied
      AI research. The goal is simple: make the foundations reusable, then connect them to real experiments.
    </Fragment>
  </Hero>

  <Features
    id="foundations"
    tagline="Foundations"
    title="The concepts I want to keep sharp"
    subtitle="This track is where existing high-quality resources become my own explanations, notes, examples, and interview-ready mental models."
    columns={3}
    items={[
      {
        title: 'Mathematics',
        description:
          'Linear algebra, calculus, optimization, graphs, and representation spaces explained through ML and NLP examples.',
        icon: 'tabler:math-symbols',
        callToAction: { text: 'Open track', href: '/category/mathematics' },
      },
      {
        title: 'Statistics',
        description:
          'Probability, distributions, confidence intervals, bootstrap testing, hypothesis tests, and uncertainty in evaluation.',
        icon: 'tabler:chart-dots',
        callToAction: { text: 'Open track', href: '/category/statistics' },
      },
      {
        title: 'Machine Learning',
        description:
          'Splits, generalization, model selection, cross-validation, losses, regularization, and practical training workflows.',
        icon: 'tabler:brain',
        callToAction: { text: 'Open track', href: '/category/machine-learning' },
      },
      {
        title: 'NLP & LLMs',
        description:
          'Tokenization, embeddings, Transformers, fine-tuning, prompting, sequence models, and language-specific evaluation.',
        icon: 'tabler:message-language',
        callToAction: { text: 'Open track', href: '/category/nlp-and-llms' },
      },
      {
        title: 'Research Engineering',
        description:
          'Experiment repositories, config-driven pipelines, logging, annotation sheets, demos, and reproducible analysis.',
        icon: 'tabler:settings-code',
        callToAction: { text: 'Open track', href: '/category/research-engineering' },
      },
    ]}
  />

  <Features
    id="research"
    tagline="Research & Applications"
    title="Broad enough for future work, concrete enough for real projects"
    subtitle="This track avoids boxing the blog into one thesis topic. It groups research by capability: building, evaluating, explaining, retrieving, and applying AI systems."
    columns={3}
    items={[
      {
        title: 'Multilingual AI',
        description:
          'Machine translation, multilingual NLP, low-resource adaptation, terminology, domain adaptation, and language variation.',
        icon: 'tabler:language',
        callToAction: { text: 'Open track', href: '/category/multilingual-ai' },
      },
      {
        title: 'Model Evaluation',
        description:
          'Metrics, benchmark design, statistical testing, ablations, error analysis, human evaluation, and robustness.',
        icon: 'tabler:checklist',
        callToAction: { text: 'Open track', href: '/category/model-evaluation' },
      },
      {
        title: 'Explainability & Responsible AI',
        description:
          'Interpretability, bias analysis, attribution, model auditing, SHAP/LIME, Shapley values, and controlled evaluation.',
        icon: 'tabler:shield-check',
        callToAction: { text: 'Open track', href: '/category/explainability-and-responsible-ai' },
      },
      {
        title: 'Retrieval & Knowledge Systems',
        description:
          'Information retrieval, RAG, long documents, graph retrieval, evidence grounding, and document intelligence.',
        icon: 'tabler:database-search',
        callToAction: { text: 'Open track', href: '/category/retrieval-and-knowledge-systems' },
      },
      {
        title: 'Applied ML Systems',
        description:
          'Data pipelines, classification, forecasting, information extraction, deployment, product demos, and applied analytics.',
        icon: 'tabler:apps',
        callToAction: { text: 'Open track', href: '/category/applied-ml-systems' },
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <BlogLatestPosts
    title="Latest notes"
    count={6}
    information="Posts may be in English, Chinese, or bilingual. Foundations posts often start from strong public resources; research posts connect those foundations to my own experiments."
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Portfolio ↗',
        href: 'https://nordic-ai.top',
        target: '_blank',
        icon: 'tabler:external-link',
      },
      {
        text: 'GitHub ↗',
        href: 'https://github.com/Entropyobserver',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">This blog complements my portfolio.</Fragment>
    <Fragment slot="subtitle">
      Portfolio pages show what I built. These notes explain the foundations, decisions, experiments, and tradeoffs
      behind the work.
    </Fragment>
  </CallToAction>
</Layout>
