---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';

const metadata = {
  title: 'Foundations',
  description:
    'Foundations track for AI Research Notes: mathematics, statistics, machine learning, NLP and LLMs, and research engineering.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Foundations"
    actions={[
      { variant: 'primary', text: 'All foundation posts', href: '/blog', icon: 'tabler:book-2' },
      { text: 'Research track', href: '/research' },
    ]}
  >
    <Fragment slot="title">Foundations I can reuse under pressure.</Fragment>
    <Fragment slot="subtitle">
      This part of the blog turns strong existing resources into my own working knowledge: concise explanations,
      bilingual notes, practical examples, and links back to the sources that shaped the post.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-blue-200 bg-blue-50 p-6 shadow-sm dark:border-blue-900 dark:bg-blue-950/40">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-300">
        Featured series
      </p>
      <h2 class="mb-3 text-3xl font-bold tracking-tight">Statistics for AI Research</h2>
      <p class="mb-5 text-muted dark:text-slate-300">
        AI 研究中的统计直觉 — a bilingual series based on strong intuition-first resources such as Seeing Theory,
        看见统计, and StatQuest, then connected to ML/NLP evaluation, MT, RAG, bias analysis, and applied AI systems.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-white hover:bg-secondary"
          href="/series/statistics-for-ai-research"
        >
          Open series
        </a>
        <a
          class="rounded-full bg-white px-5 py-2 text-sm font-semibold text-slate-800 ring-1 ring-slate-200 hover:bg-slate-50 dark:bg-slate-900 dark:text-slate-100 dark:ring-slate-700"
          href="/why-statistics-matters-for-ai-research"
        >
          Read first note
        </a>
      </div>
    </div>
  </section>

  <Features
    title="Foundation tracks"
    subtitle="Each track is broad enough for interviews and deep enough to support research writing."
    columns={3}
    items={[
      {
        title: 'Mathematics',
        description:
          'Vectors, matrices, embeddings, dot products, optimization, gradients, PCA, and graph ideas used in ML/NLP.',
        icon: 'tabler:math-symbols',
        callToAction: { text: 'Read Mathematics', href: '/category/mathematics' },
      },
      {
        title: 'Statistics',
        description:
          'Probability, distributions, confidence intervals, hypothesis tests, bootstrap resampling, and experimental uncertainty.',
        icon: 'tabler:chart-dots',
        callToAction: { text: 'Read Statistics', href: '/category/statistics' },
      },
      {
        title: 'Machine Learning',
        description:
          'Train/validation/test splits, overfitting, cross-validation, regularization, model selection, losses, and tuning.',
        icon: 'tabler:brain',
        callToAction: { text: 'Read Machine Learning', href: '/category/machine-learning' },
      },
      {
        title: 'NLP & LLMs',
        description:
          'Tokenization, embeddings, Transformers, fine-tuning, prompting, generation, and NLP evaluation basics.',
        icon: 'tabler:message-language',
        callToAction: { text: 'Read NLP & LLMs', href: '/category/nlp-and-llms' },
      },
      {
        title: 'Research Engineering',
        description:
          'How experiments become reproducible: configs, logs, evaluation tables, data checks, demos, and documentation.',
        icon: 'tabler:settings-code',
        callToAction: { text: 'Read Research Engineering', href: '/category/research-engineering' },
      },
    ]}
  />
</Layout>
