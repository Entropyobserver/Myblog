---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AI 研究中的统计直觉',
  description: '一个关于统计基础、不确定性、模型评估，以及从统计到机器学习的中文系列。',
};

const sections = [
  {
    part: 'Part I',
    title: '统计基础',
    notes: [
      ['为什么统计对 AI 研究很重要', '/zh/why-statistics-matters-for-ai-research'],
      ['随机变量、期望和方差', '/zh/random-variables-expectation-and-variance'],
      ['机器学习中的概率分布', '/zh/probability-distributions-for-machine-learning'],
    ],
  },
  {
    part: 'Part II',
    title: '不确定性与模型评估',
    notes: [
      ['置信区间：为什么一个分数不够', '/zh/confidence-intervals-one-score-is-not-enough'],
      ['模型评估中的 Bootstrap Resampling', '/zh/bootstrap-resampling-for-model-evaluation'],
      ['不要仪式化地使用假设检验', '/zh/hypothesis-testing-without-rituals'],
      ['效应量：显著不等于重要', '/zh/effect-size-statistical-significance-is-not-enough'],
    ],
  },
  {
    part: 'Part III',
    title: '从统计到机器学习',
    notes: [
      ['作为统计模型的线性回归', '/zh/linear-regression-as-a-statistical-model'],
      ['正则化：L1 和 L2 背后的统计思想', '/zh/regularization-statistics-behind-l1-and-l2'],
      ['Bias–Variance Trade-off', '/zh/bias-variance-tradeoff'],
      ['PCA：从方差到表示空间', '/zh/pca-from-variance-to-representation'],
      ['最大似然估计：模型为什么能学习参数', '/zh/maximum-likelihood-estimation-why-models-learn-parameters'],
      ['MAP 估计与贝叶斯思维', '/zh/map-estimation-and-bayesian-thinking'],
    ],
  },
  {
    part: 'Part IV',
    title: 'AI/NLP 研究中的统计思维',
    notes: [
      ['多重比较：AI 实验中的隐藏问题', '/zh/multiple-comparisons-in-ai-experiments'],
      ['Power Analysis：到底需要多少实验', '/zh/power-analysis-how-many-experiments'],
      ['用于多模型比较的 ANOVA', '/zh/anova-for-comparing-multiple-models'],
      ['NLP 和 LLM 评估中的统计检验', '/zh/statistical-testing-for-nlp-and-llm-evaluation'],
      ['AI 研究中的相关性与因果性', '/zh/correlation-vs-causation-in-ai-research'],
    ],
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="系列"
    actions={[
      {
        variant: 'primary',
        text: '阅读第一篇',
        href: '/zh/why-statistics-matters-for-ai-research',
        icon: 'tabler:chart-dots',
      },
      { text: 'EN', href: '/series/statistics-for-ai-research' },
      { text: '统计分类', href: '/category/statistics' },
    ]}
  >
    <Fragment slot="title">AI 研究中的统计直觉</Fragment>
    <Fragment slot="subtitle">
      从概率、统计推断到 ML/NLP evaluation 的实践型学习路线。每篇都有独立英文版，并且可以在文章顶部切换语言。
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        sections.map((section) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-600 dark:text-blue-300">
              {section.part}
            </p>
            <h2 class="mb-4 text-2xl font-bold">{section.title}</h2>
            <ol class="space-y-3 text-muted dark:text-slate-300">
              {section.notes.map(([title, href], index) => (
                <li>
                  <a class="hover:text-primary" href={href}>
                    {index + 1}. {title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <Features
    title="这个系列怎么设计"
    subtitle="它会吸收 Seeing Theory、看见统计、StatQuest、Think Stats、ISLR/ISLP 和统计推断教材的优点，然后转化成 AI/NLP 研究习惯。"
    columns={3}
    items={[
      {
        title: '先建立概念图',
        description: '每篇都先给直觉模型，再进入公式、实验和研究表达。',
        icon: 'tabler:bulb',
      },
      {
        title: '连接 AI/NLP 场景',
        description: '例子会连接 MT、RAG、LLM evaluation、bias analysis 和 applied ML systems。',
        icon: 'tabler:microscope',
      },
      {
        title: '服务研究写作',
        description: '重点不是只会算一个数，而是知道如何谨慎地提出研究结论。',
        icon: 'tabler:writing',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '阅读第一篇',
        href: '/zh/why-statistics-matters-for-ai-research',
        icon: 'tabler:arrow-right',
      },
      { text: 'English version', href: '/series/statistics-for-ai-research' },
    ]}
  >
    <Fragment slot="title">先从不确定性开始。</Fragment>
    <Fragment slot="subtitle">
      我对统计的工作定义是：当 AI 实验给出一个数字时，统计帮助我判断这个数字有多可信。
    </Fragment>
  </CallToAction>
</Layout>
