---
import { Icon } from 'astro-icon/components';

const stages = [
  {
    label: 'Foundations',
    title: 'Understand the ideas',
    description: 'Mathematics · Statistics · ML · NLP & LLMs',
    icon: 'tabler:books',
  },
  {
    label: 'Research',
    title: 'Test them with evidence',
    description: 'Questions · Experiments · Evaluation',
    icon: 'tabler:microscope',
  },
  {
    label: 'Applied systems',
    title: 'Make them work',
    description: 'Multilingual AI · Retrieval · Applied ML',
    icon: 'tabler:route',
  },
];
---

<div
  class="mx-auto grid max-w-4xl items-stretch gap-3 text-left sm:grid-cols-[1fr_auto_1fr_auto_1fr] sm:items-center"
  role="img"
  aria-label="The site connects reusable foundations to evidence-based research and applied AI systems."
>
  {
    stages.map((stage, index) => (
      <>
        <div class="h-full rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200 dark:bg-slate-900/70 dark:ring-slate-700">
          <div class="mb-4 flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-100 text-primary dark:bg-blue-950">
              <Icon name={stage.icon} class="h-5 w-5" aria-hidden="true" />
            </span>
            <span class="text-xs font-bold uppercase tracking-[0.14em] text-primary dark:text-blue-300">
              {stage.label}
            </span>
          </div>
          <p class="font-heading text-lg font-bold text-slate-900 dark:text-white">{stage.title}</p>
          <p class="mt-2 text-sm leading-6 text-muted dark:text-slate-300">{stage.description}</p>
        </div>
        {index < stages.length - 1 && (
          <Icon name="tabler:arrow-right" class="mx-auto hidden h-5 w-5 text-slate-400 sm:block" aria-hidden="true" />
        )}
      </>
    ))
  }
</div>
